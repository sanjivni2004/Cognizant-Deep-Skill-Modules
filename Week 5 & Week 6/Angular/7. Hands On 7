### Step 77: `CanDeactivate` Guard for Unsaved Changes

Generate the guard:

```bash
ng generate guard guards/unsaved-changes

```

Create an interface to enforce that target components expose an `isDirty()` method or boolean:

#### `src/app/guards/unsaved-changes.guard.ts`

```typescript
import { CanDeactivateFn } from '@angular/router';

export interface ComponentWithUnsavedChanges {
  hasUnsavedChanges: () => boolean;
}

// 77. Modern functional CanDeactivateFn
export const unsavedChangesGuard: CanDeactivateFn<ComponentWithUnsavedChanges> = (component) => {
  if (component.hasUnsavedChanges && component.hasUnsavedChanges()) {
    return window.confirm('You have unsaved changes. Are you sure you want to leave?');
  }
  return true;
};

```

Update your `ReactiveEnrollmentFormComponent` to expose `hasUnsavedChanges()`:

#### `src/app/pages/reactive-enrollment-form/reactive-enrollment-form.component.ts` (Snippet)

```typescript
import { ComponentWithUnsavedChanges } from '../../guards/unsaved-changes.guard';

export class ReactiveEnrollmentFormComponent implements ComponentWithUnsavedChanges {
  // Method required by UnsavedChangesGuard
  hasUnsavedChanges(): boolean {
    return this.enrollForm ? this.enrollForm.dirty && !this.submitted : false;
  }
}

```

