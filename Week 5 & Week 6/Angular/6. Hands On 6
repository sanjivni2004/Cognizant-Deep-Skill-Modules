```html
<section class="form-container">
  <h2>Reactive Student Enrollment Form</h2>

  <div *ngIf="submitted" class="alert alert-success">
    Reactive Enrollment Request Submitted Successfully!
  </div>

  <!-- 50. Bind formGroup -->
  <form [formGroup]="enrollForm" (ngSubmit)="onSubmit()" novalidate>

    <!-- Student Name -->
    <div class="form-group">
      <label for="studentName">Student Name *</label>
      <input 
        type="text" 
        id="studentName" 
        formControlName="studentName" 
        class="form-control"
      />
      <div *ngIf="f['studentName'].invalid && f['studentName'].touched" class="error-feedback">
        <small *ngIf="f['studentName'].errors?.['required']">Name is required.</small>
        <small *ngIf="f['studentName'].errors?.['minlength']">Name must be at least 3 characters.</small>
      </div>
    </div>

    <!-- Student Email (with Async Validator) -->
    <div class="form-group">
      <label for="studentEmail">Email Address *</label>
      <input 
        type="email" 
        id="studentEmail" 
        formControlName="studentEmail" 
        class="form-control"
      />
      <!-- Async pending state -->
      <small *ngIf="f['studentEmail'].pending" class="info-feedback">Checking email availability...</small>
      
      <div *ngIf="f['studentEmail'].invalid && f['studentEmail'].touched" class="error-feedback">
        <small *ngIf="f['studentEmail'].errors?.['required']">Email address is required.</small>
        <small *ngIf="f['studentEmail'].errors?.['email']">Please enter a valid email address.</small>
        <!-- 55. Async validator custom error -->
        <small *ngIf="f['studentEmail'].errors?.['emailTaken']">Email address is already taken (test&#64; accounts disallowed).</small>
      </div>
    </div>

    <!-- Course ID (with Custom Sync Validator) -->
    <div class="form-group">
      <label for="courseId">Course Code/ID *</label>
      <input 
        type="text" 
        id="courseId" 
        formControlName="courseId" 
        placeholder="e.g. CS101" 
        class="form-control"
      />
      <div *ngIf="f['courseId'].invalid && f['courseId'].touched" class="error-feedback">
        <small *ngIf="f['courseId'].errors?.['required']">Course ID is required.</small>
        <!-- 54. Custom synchronous error message -->
        <small *ngIf="f['courseId'].errors?.['noCourseCode']">Course code starting with XX is not allowed.</small>
      </div>
    </div>

    <!-- Preferred Semester -->
    <div class="form-group">
      <label for="preferredSemester">Preferred Semester</label>
      <select id="preferredSemester" formControlName="preferredSemester" class="form-control">
        <option value="Odd">Odd Semester</option>
        <option value="Even">Even Semester</option>
      </select>
    </div>

    <!-- 56. Dynamic FormArray Section -->
    <div class="form-group dynamic-section">
      <label>Additional Courses to Enroll</label>
      
      <div formArrayName="additionalCourses">
        <div 
          *ngFor="let courseControl of additionalCourses.controls; let i = index" 
          class="dynamic-row"
        >
          <input 
            type="text" 
            [formControlName]="i" 
            placeholder="Course Code {{ i + 1 }}" 
            class="form-control"
          />
          <button type="button" (click)="removeCourse(i)" class="btn btn-danger">
            Remove
          </button>
        </div>
      </div>

      <button type="button" (click)="addCourse()" class="btn btn-outline">
        + Add Another Course
      </button>
    </div>

    <!-- Terms & Conditions Checkbox -->
    <div class="form-group checkbox-group">
      <label>
        <input type="checkbox" formControlName="agreeToTerms" />
        I agree to the enrollment terms and conditions *
      </label>
      <div *ngIf="f['agreeToTerms'].invalid && f['agreeToTerms'].touched" class="error-feedback">
        <small>You must accept the terms to proceed.</small>
      </div>
    </div>

    <!-- Submit Button (51. Disabled when form is invalid) -->
    <div class="button-group">
      <button type="submit" [disabled]="enrollForm.invalid" class="btn btn-primary">
        Submit
      </button>
    </div>

  </form>
</section>

