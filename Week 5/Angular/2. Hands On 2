# Task 1: All Four Binding Types

# Step 11–15: Updating `HomeComponent`

In modern Angular (v17+/v20), components use the standalone API by default. We will import `FormsModule` directly into `HomeComponent`.

# `src/app/pages/home/home.component.ts`

```typescript
import { Component } from '@angular/core';
import { CommonModule } from '@angular/common';
import { FormsModule } from '@angular/forms'; // Required for [(ngModel)]

@Component({
  selector: 'app-home',
  standalone: true,
  imports: [CommonModule, FormsModule],
  templateUrl: './home.component.html',
  styleUrls: ['./home.component.css']
})
export class HomeComponent {
  // 11. String interpolation property
  portalName: string = 'Student Course Portal';

  // 12. Property binding flag
  isPortalActive: boolean = true;

  // 13. Message property updated via event binding
  message: string = '';

  // 14. Property bound to input via [(ngModel)]
  searchTerm: string = '';

  // 13. Event binding handler
  onEnrollClick(): void {
    this.message = 'Enrollment opened!';
  }

 }

```

# `src/app/pages/home/home.component.html`

```html
<section class="home-container">
  <!-- 11. String Interpolation -->
  <h1>Welcome to {{ portalName }}</h1>

  <p>Manage your academic journey, view enrolled courses, and track your progress all in one place.</p>

  <!-- 12 & 13. Property Binding [disabled] and Event Binding (click) -->
  <button [disabled]="!isPortalActive" (click)="onEnrollClick()">
    Enroll Now
  </button>

  <!-- Display message resulting from event binding -->
  <p *ngIf="message" class="alert-message">{{ message }}</p>

  <hr />

  <!-- 14. Two-Way Binding with [(ngModel)] -->
  <div class="search-box">
    <label for="search">Search Courses: </label>
    <input 
      id="search"
      type="text" 
      [(ngModel)]="searchTerm" 
      placeholder="Type a course name..." 
    />
    <p>Searching for: <strong>{{ searchTerm }}</strong></p>
  </div>
</section>

```

