# Task 3: `@Input` and `@Output` Parent-Child Communication

# Step 19, 22–24: Implementing `CourseListComponent`

# `src/app/pages/course-list/course-list.component.ts`

```typescript
import { Component } from '@angular/core';
import { CommonModule } from '@angular/common';
import { CourseCardComponent, Course } from '../../components/course-card/course-card.component';

@Component({
  selector: 'app-course-list',
  standalone: true,
  imports: [CommonModule, CourseCardComponent],
  templateUrl: './course-list.component.html',
  styleUrls: ['./course-list.component.css']
})
export class CourseListComponent {
  // 22. Array of 5 course objects
  courses: Course[] = [
    { id: 101, name: 'Angular Fundamentals', code: 'CS101', credits: 4 },
    { id: 102, name: 'TypeScript Deep Dive', code: 'CS102', credits: 3 },
    { id: 103, name: 'Web Development BootCamp', code: 'CS103', credits: 4 },
    { id: 104, name: 'Data Structures in JS', code: 'CS104', credits: 3 },
    { id: 105, name: 'RxJS & Reactive Patterns', code: 'CS105', credits: 2 }
  ];

  // Property to store the selected ID
  selectedCourseId: number | null = null;

  // 23. Receiver method handling child @Output event
  onEnroll(courseId: number): void {
    console.log('Enrolling in course: ' + courseId);
    this.selectedCourseId = courseId;
  }
}

```

# `src/app/pages/course-list/course-list.component.html`

```html
<section class="course-list-container">
  <h2>Available Courses</h2>

  <div class="cards-wrapper">
    <!-- 22. Iterate over courses, bind input [course] and output (enrollRequested) -->
    <app-course-card 
      *ngFor="let c of courses" 
      [course]="c" 
      (enrollRequested)="onEnroll($event)">
    </app-course-card>
  </div>

  <hr />

  <!-- 24. Display selected course ID -->
  <p class="selected-status">
    Selected course ID: <strong>{{ selectedCourseId !== null ? selectedCourseId : 'None' }}</strong>
  </p>
</section>

```

