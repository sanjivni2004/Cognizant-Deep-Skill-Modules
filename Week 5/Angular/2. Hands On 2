# Step 18, 20 & 21: Creating `CourseCardComponent`

Generate the component using CLI:

```bash
ng generate component components/course-card

```

Now implement `@Input`, `@Output`, and `ngOnChanges`:

# `src/app/components/course-card/course-card.component.ts`

```typescript
import { Component, Input, Output, EventEmitter, OnChanges, SimpleChanges } from '@angular/core';
import { CommonModule } from '@angular/common';

// Define Interface for strict typing
export interface Course {
  id: number;
  name: string;
  code: string;
  credits: number;
}

@Component({
  selector: 'app-course-card',
  standalone: true,
  imports: [CommonModule],
  templateUrl: './course-card.component.html',
  styleUrls: ['./course-card.component.css']
})
export class CourseCardComponent implements OnChanges {
  // 18 & 20. @Input property with custom course type
  @Input() course!: Course;

  // 21. Strongly-typed @Output event emitter passing the course ID
  @Output() enrollRequested = new EventEmitter<number>();

  // 18. ngOnChanges Hook
  ngOnChanges(changes: SimpleChanges): void {
    if (changes['course']) {
      console.log('CourseCardComponent input changed:', {
        previousValue: changes['course'].previousValue,
        currentValue: changes['course'].currentValue,
        firstChange: changes['course'].firstChange
      });
    }
  }

  // 21. Trigger method when button is clicked
  onEnroll(): void {
    this.enrollRequested.emit(this.course.id);
  }
}

```

# `src/app/components/course-card/course-card.component.html`

```html
<div class="course-card">
  <!-- 20. Render course data fields -->
  <h3>{{ course.name }}</h3>
  <p><strong>Code:</strong> {{ course.code }}</p>
  <p><strong>Credits:</strong> {{ course.credits }}</p>

  <!-- 21. Event trigger button -->
  <button (click)="onEnroll()">Enroll</button>
</div>

```

