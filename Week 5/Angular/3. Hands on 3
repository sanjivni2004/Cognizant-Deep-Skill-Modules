import { Component, Input, Output, EventEmitter } from '@angular/core';
import { CommonModule } from '@angular/common';

export interface Course {
  id: number;
  name: string;
  code: string;
  credits: number | null;
  gradeStatus: 'passed' | 'failed' | 'pending';
}

@Component({
  selector: 'app-course-card',
  standalone: true,
  imports: [CommonModule],
  templateUrl: './course-card.component.html',
  styleUrls: ['./course-card.component.css']
})
export class CourseCardComponent {
  @Input() course!: Course;
  @Input() isEnrolled: boolean = false;
  @Output() enrollRequested = new EventEmitter<number>();

  // 31. Expansion state property
  isExpanded: boolean = false;

  // 31. Toggle method
  toggleDetails(): void {
    this.isExpanded = !this.isExpanded;
  }

 
  get cardClasses(): { [key: string]: boolean } {
    return {
      'card--enrolled': this.isEnrolled,
      'card--full': (this.course.credits ?? 0) >= 4,
      'expanded': this.isExpanded
    };
  }

  // 30. Getter for ngStyle dynamic left border color
  get cardStyles(): { [key: string]: string } {
    let borderColor = 'grey'; // Default for 'pending'

    if (this.course.gradeStatus === 'passed') {
      borderColor = 'green';
    } else if (this.course.gradeStatus === 'failed') {
      borderColor = 'red';
    }

    return {
      'border-left': `5px solid ${borderColor}`
    };
  }

  onEnroll(): void {
    this.enrollRequested.emit(this.course.id);
  }
}

```

