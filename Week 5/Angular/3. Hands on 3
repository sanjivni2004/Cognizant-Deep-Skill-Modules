### Step 35: Creating the `CreditLabelPipe`

Generate the pipe:

```bash
ng generate pipe pipes/credit-label

```

# `src/app/pipes/credit-label.pipe.ts`

```typescript
import { Pipe, PipeTransform } from '@angular/core';

@Pipe({
  name: 'creditLabel',
  standalone: true
})
export class CreditLabelPipe implements PipeTransform {
  // 35. Transform credits number into formatted string with edge-case handling
  transform(value: number | null | undefined): string {
    if (value === null || value === undefined || value === 0) {
      return 'No Credits';
    }
    if (value === 1) {
      return '1 Credit';
    }
    return `${value} Credits`;
  }
}

