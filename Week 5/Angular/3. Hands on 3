# Step 33 & 37: Creating the Configurable `HighlightDirective`

Generate the directive:

```bash
ng generate directive directives/highlight

```

#### `src/app/directives/highlight.directive.ts`

```typescript
import { Directive, ElementRef, HostListener, Input, Renderer2 } from '@angular/core';

@Directive({
  selector: '[appHighlight]',
  standalone: true
})
export class HighlightDirective {
  // 37. Configurable input color with default value 'yellow'
  @Input() appHighlight: string = 'yellow';

  constructor(private el: ElementRef, private renderer: Renderer2) {}

  // 33. Listen to mouseenter event on host element
  @HostListener('mouseenter') onMouseEnter(): void {
    this.setBgColor(this.appHighlight || 'yellow');
  }

  // 33. Listen to mouseleave event on host element
  @HostListener('mouseleave') onMouseLeave(): void {
    this.setBgColor('');
  }

  private setBgColor(color: string): void {
    this.renderer.setStyle(this.el.nativeElement, 'backgroundColor', color);
  }
}

