<section class="form-container">
  <h2>Student Enrollment Request</h2>

  <!-- 46. Success banner -->
  <div *ngIf="submitted" class="alert alert-success">
    Enrollment request submitted successfully!
  </div>

  <!-- 39. Form wrapper with template reference #enrollForm="ngForm" -->
  <form #enrollForm="ngForm" (ngSubmit)="onSubmit(enrollForm)" novalidate>

    <!-- Student Name -->
    <div class="form-group">
      <label for="studentName">Student Name *</label>
      <input 
        type="text" 
        id="studentName" 
        name="studentName" 
        [(ngModel)]="formData.studentName" 
        #nameCtrl="ngModel" 
        required 
        minlength="3" 
        class="form-control"
      />
      <!-- 44. Contextual validation messages for studentName -->
      <div *ngIf="nameCtrl.invalid && nameCtrl.touched" class="error-feedback">
        <small *ngIf="nameCtrl.errors?.['required']">Name is required.</small>
        <small *ngIf="nameCtrl.errors?.['minlength']">Name must be at least 3 characters.</small>
      </div>
    </div>

    <!-- Student Email -->
    <div class="form-group">
      <label for="studentEmail">Email Address *</label>
      <input 
        type="email" 
        id="studentEmail" 
        name="studentEmail" 
        [(ngModel)]="formData.studentEmail" 
        #emailCtrl="ngModel" 
        required 
        email 
        class="form-control"
      />
      <!-- Contextual validation messages for email -->
      <div *ngIf="emailCtrl.invalid && emailCtrl.touched" class="error-feedback">
        <small *ngIf="emailCtrl.errors?.['required']">Email address is required.</small>
        <small *ngIf="emailCtrl.errors?.['email']">Please enter a valid email address.</small>
      </div>
    </div>

    <!-- Course ID -->
    <div class="form-group">
      <label for="courseId">Course ID *</label>
      <input 
        type="number" 
        id="courseId" 
        name="courseId" 
        [(ngModel)]="formData.courseId" 
        #courseCtrl="ngModel" 
        required 
        class="form-control"
      />
      <div *ngIf="courseCtrl.invalid && courseCtrl.touched" class="error-feedback">
        <small *ngIf="courseCtrl.errors?.['required']">Course ID is required.</small>
      </div>
    </div>

    <!-- Preferred Semester -->
    <div class="form-group">
      <label for="preferredSemester">Preferred Semester</label>
      <select 
        id="preferredSemester" 
        name="preferredSemester" 
        [(ngModel)]="formData.preferredSemester" 
        class="form-control">
        <option value="Odd">Odd Semester</option>
        <option value="Even">Even Semester</option>
      </select>
    </div>

    <!-- Terms & Conditions Checkbox -->
    <div class="form-group checkbox-group">
      <label>
        <input 
          type="checkbox" 
          id="agreeToTerms" 
          name="agreeToTerms" 
          [(ngModel)]="formData.agreeToTerms" 
          #termsCtrl="ngModel" 
