      <div *ngIf="termsCtrl.invalid && termsCtrl.touched" class="error-feedback">
        <small *ngIf="termsCtrl.errors?.['required']">You must accept the terms to proceed.</small>
      </div>
    </div>

    <!-- Action Buttons -->
    <div class="button-group">
      <!-- 41. Submit button disabled when form is invalid -->
      <button type="submit" [disabled]="enrollForm.invalid" class="btn btn-primary">
        Submit
